# Copy to .env and fill in. docker compose refuses to start while a required value is unset.
# .env is git-ignored - never commit real secrets.

# --- required ---
TICKETING_DB_PASSWORD=change-me-ticketing
USER_DB_PASSWORD=change-me-user

# --- local DEMO conveniences (leave these out / false anywhere real) ---
# Seeds a well-known admin (admin@commerceforge.local / Admin@12345) into user-service.
USER_SERVICE_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/dev-seed
# Lets the frontend's "Simulate failed payment" / forced outcomes work.
TICKETING_PAYMENT_ALLOW_FORCE_OUTCOME=true

# Buying requires a verified email. Demo only: false lets you buy without an SMTP inbox to verify with.
TICKETING_REQUIRE_VERIFIED_EMAIL=false

# Payment provider: "mock" (synchronous fake, default) or "vnpay" (VNPay sandbox - redirect + signed IPN).
# For vnpay fill the three values below (from your sandbox merchant registration, see docs/setup.md).
# VNPAY_RETURN_URL is the frontend page the buyer lands on, e.g. http://localhost:5173/payment/result
# The IPN URL (<public https>/api/payment/vnpay/ipn) is set in VNPay's merchant portal, not here.
TICKETING_PAYMENT_PROVIDER=mock
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=

# --- optional ---
# SMTP (e.g. Mailtrap sandbox); without credentials the app runs but emails fail (logged only).
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# From address - must be a sender/domain verified with your SMTP provider or mail may be rejected.
MAIL_FROM=no-reply@gatekeep.example
# Browser origin of the frontend (CORS) and base for links in emails.
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
# Set true only behind a reverse proxy that overwrites X-Forwarded-For.
TICKETING_RATE_LIMIT_TRUST_FORWARDED_FOR=false
