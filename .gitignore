# Keep repository rules and backend source uploadable, including when local
# .git/info/exclude contains a broad backend/ rule. Do not unignore backend/**:
# generated files and credentials below must remain excluded.
!/.gitignore
!/backend/

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/

# Eclipse
.classpath
.project
.settings/
bin/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Package Files
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Wrapper binaries/configuration are required for reproducible builds.
!**/.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.properties
!**/gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs
hs_err_pid*
replay_pid*
*.hprof

# Log files
*.log
logs/

# Environment files (keep sanitized templates)
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Application properties overrides
application-*.properties
!application-example.properties

# MongoDB
*.ns
*.0
*.1
*.2
mongod.lock
/data/db/

# Kafka
kafka-logs/
zookeeper/

# Mac OS specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux specific
*~

# Kubernetes
k8s/
k8s/*.yaml
!k8s/example-*.yaml

# Docker
.docker/
!**/.dockerignore
!docker-compose*.yml

# Maven wrapper
!.mvn/wrapper/

# Spring Boot Actuator
/heapdump/
/heapdump.hprof

# Testing
**/test-output/
**/surefire-reports/
**/failsafe-reports/
**/target/surefire-reports/
**/target/failsafe-reports/

# IDE specific files
.apt_generated/
.factorypath
.springBeans
.sts4-cache/

# Local development environment files
.local-*

# Credentials and sensitive data
**/src/main/resources/application-*.properties
!**/src/main/resources/application-example.properties
**/src/main/resources/*.jks
**/src/main/resources/*.p12
**/src/main/resources/*.crt
**/src/main/resources/*.key

# Application specific
tmp/
temp/

# Docker volume data
volume-data/
backend/product-service/data/
backend/identity-service/docker/postgres/data/
backend/ticketing-platform/postgres-data/

# Locally generated QR/JWT signing keys
**/keys/
*.pem
*.key
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.mobileprovision
.aws/

# Keep empty directories
!.gitkeep

# Node modules
node_modules/

# Bundles, dependency caches and generated Expo files
dist/
dist-ssr/
web-build/
.expo/
expo-env.d.ts
.cache/
.npm/
.vite/
.parcel-cache/
*.tsbuildinfo
.metro-health-check*
.kotlin/

# Test output (keep test source and runner configuration)
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Local Python helpers and editor/assistant state
.venv/
venv/
__pycache__/
*.py[cod]
.claude/
.codex/
*.swp
*.swo
*.bak
*.orig

# Archived frontend; the maintained application is frontend/.
/frontend_old/

# Keep dependency lockfiles even if a local exclude contains *.lock.
!package-lock.json
!yarn.lock
!pnpm-lock.yaml
!bun.lock
!bun.lockb
!gradle.lockfile
