/.nb-gradle/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Log files
*.log

# Environment files
.env
.env.local
.env.development
.env.test
.env.production

# Application properties overrides - none of the 9 backend services actually use the
# application-<profile>.properties naming convention today (each only has a single
# src/main/resources/application.properties with demo-only local-dev defaults, checked in on
# purpose - see docs/setup.md). This rule exists so that if you create a local override file
# (e.g. application-local.properties) to hold real, non-demo credentials, it's excluded by
# default instead of accidentally being tracked.
application-*.properties
!application-example.properties

# MongoDB
*.ns
*.0
*.1
*.2
*.lock
mongod.lock
/data/db/

# Kafka
kafka-logs/
zookeeper/

# Mac OS specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux specific
*~

# Kubernetes - scoped to k8s/ only; an unscoped "*.yaml" here would silently ignore every .yaml
# file in the whole repo, not just k8s manifests (harmless today since the repo only uses .yml,
# but would drop future non-k8s .yaml files without anyone noticing).
k8s/
k8s/*.yaml
!k8s/example-*.yaml

# Docker
.docker/
*.dockerignore
!docker-compose*.yml

# Maven wrapper
!.mvn/wrapper/

# Spring Boot Actuator
/heapdump/
/heapdump.hprof

# Testing
**/test-output/
**/surefire-reports/
**/failsafe-reports/
**/target/surefire-reports/
**/target/failsafe-reports/

# IDE specific files that might be generated on the fly, configuration files.
.apt_generated/
.factorypath
.springBeans
.sts4-cache/

# Local development environment files
.local-*

# Credentials and sensitive data (same rationale as the "Application properties overrides"
# rule above - kept here too since this block also covers keystores/certs, which the rule
# above doesn't)
**/src/main/resources/application-*.properties
!**/src/main/resources/application-example.properties
**/src/main/resources/*.jks
**/src/main/resources/*.p12
**/src/main/resources/*.crt
**/src/main/resources/*.key

# Application specific
tmp/
temp/

# Dependencies, generated frontend bundles and local caches
node_modules/
dist/
dist-ssr/
.cache/
.npm/
.vite/
*.tsbuildinfo

# Generated test reports and browser artifacts
coverage/
.nyc_output/
playwright-report/
blob-report/
test-results/
playwright/.cache/

# Local helper environments
.venv/
venv/
__pycache__/
*.pyc

# Local repository automation is excluded from the runtime source upload.
/.github/

# Docker volume data (runtime data, must not be versioned)
volume-data/
backend/product-service/data/
backend/inventory-service/docker/postgres/data/
backend/order-service/postgres-data/

# Environment variables
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Keep empty directories
!.gitkeep

# Locally generated QR/JWT signing keys (ticketing-platform, user-service) - never commit
**/keys/
# Temper
backend/
docs/
EventHub_18_man_hinh_rieng/
frontend_old/
image_support/
/docker-compose.yml
README.md/

playwright.config.ts/
