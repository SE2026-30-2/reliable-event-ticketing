# Leave these unset when Expo and Docker run on the same machine over LAN.
# The app automatically uses the Expo development server's hostname.
# Only uncomment and replace these URLs when the backend runs elsewhere,
# when using an Expo tunnel, or when building a standalone app.
# Android emulator: http://10.0.2.2; physical device: the backend's LAN IP.
# EXPO_PUBLIC_IDENTITY_SERVICE_URL=http://192.168.1.10:8087
# EXPO_PUBLIC_TICKETING_SERVICE_URL=http://192.168.1.10:8091
